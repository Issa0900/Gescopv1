{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "payment_terms": {
      "type": "string"
    },
    "average_delivery_days": {
      "type": "number"
    },
    "purchase_volume": {
      "type": "number"
    },
    "quality_score": {
      "type": "number"
    },
    "reliability_score": {
      "type": "number"
    },
    "price_change_last_12_months": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "actif",
        "inactif",
        "problematique"
      ]
    },
    "neq_number": {
      "type": "string"
    },
    "gst_number": {
      "type": "string"
    },
    "qst_number": {
      "type": "string"
    },
    "purchase_currency": {
      "type": "string"
    },
    "esg_score": {
      "type": "number"
    },
    "import_id": {
      "type": "string"
    }
  },
  "required": [
    "supplier_id",
    "supplier_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}