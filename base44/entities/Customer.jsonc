{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "customer_type": {
      "type": "string"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date"
    },
    "first_purchase_date": {
      "type": "string",
      "format": "date"
    },
    "last_purchase_date": {
      "type": "string",
      "format": "date"
    },
    "total_orders": {
      "type": "number"
    },
    "total_revenue": {
      "type": "number"
    },
    "average_order_value": {
      "type": "number"
    },
    "status": {
      "type": "string"
    },
    "segment": {
      "type": "string"
    },
    "lifetime_value": {
      "type": "number"
    },
    "churn_risk": {
      "type": "number"
    },
    "postal_code": {
      "type": "string"
    },
    "loyalty_points": {
      "type": "number"
    },
    "language": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "tax_exemption_number": {
      "type": "string"
    },
    "credit_limit": {
      "type": "number"
    },
    "import_id": {
      "type": "string"
    }
  },
  "required": [
    "customer_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}