{
  "name": "Inventory",
  "type": "object",
  "properties": {
    "inventory_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "product_id": {
      "type": "string"
    },
    "opening_stock": {
      "type": "number"
    },
    "purchases": {
      "type": "number"
    },
    "units_sold": {
      "type": "number"
    },
    "returns": {
      "type": "number"
    },
    "damaged": {
      "type": "number"
    },
    "closing_stock": {
      "type": "number"
    },
    "inventory_value": {
      "type": "number"
    },
    "days_in_inventory": {
      "type": "number"
    },
    "unit_cost": {
      "type": "number"
    },
    "selling_price": {
      "type": "number"
    },
    "product_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "stock_status": {
      "type": "string",
      "enum": [
        "optimal",
        "rupture",
        "surstock",
        "dormant",
        "faible",
        "proche_rupture"
      ]
    },
    "warehouse_id": {
      "type": "string"
    },
    "warehouse_name": {
      "type": "string"
    },
    "reserved_qty": {
      "type": "number"
    },
    "in_transit_qty": {
      "type": "number"
    },
    "reorder_qty_eoq": {
      "type": "number"
    },
    "reorder_point": {
      "type": "number"
    },
    "origin_country": {
      "type": "string"
    },
    "customs_code": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "import_id": {
      "type": "string"
    }
  },
  "required": [
    "product_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}